{
  "name": "eventore-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "bundle:openapi": "node scripts/bundle-openapi.mjs",
    "generate:api": "npm run bundle:openapi && openapi-typescript ../backend/openapi/eventore-api-bundled.yaml -o src/api/generated/schema.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
