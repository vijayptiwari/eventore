# Build from repository root: docker build -f docker/Dockerfile.backend .
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY backend/pom.xml backend/pom.xml
COPY backend/eventore-core backend/eventore-core
COPY backend/eventore-api-codegen backend/eventore-api-codegen
COPY backend/eventore-provider-kafka backend/eventore-provider-kafka
COPY backend/eventore-provider-mqtt backend/eventore-provider-mqtt
COPY backend/eventore-provider-jms backend/eventore-provider-jms
COPY backend/eventore-provider-pulsar backend/eventore-provider-pulsar
COPY backend/eventore-provider-rabbitmq backend/eventore-provider-rabbitmq
COPY backend/eventore-provider-kinesis backend/eventore-provider-kinesis
COPY backend/eventore-provider-gcp-pubsub backend/eventore-provider-gcp-pubsub
COPY backend/eventore-provider-azure-servicebus backend/eventore-provider-azure-servicebus
COPY backend/eventore-server backend/eventore-server
COPY backend/openapi backend/openapi
WORKDIR /app/backend
# Comma-separated Maven profiles, e.g. provider-kafka or provider-kafka,provider-kinesis
# Local all-providers dev build: EVENTORE_STREAM_PROFILES=providers-all
ARG EVENTORE_STREAM_PROFILES=providers-all
RUN set -eux; \
    if [ "$EVENTORE_STREAM_PROFILES" = "providers-all" ]; then \
      mvn -B -DskipTests package; \
    else \
      PROFILE_ARGS=""; \
      IFS=','; \
      for p in $EVENTORE_STREAM_PROFILES; do \
        PROFILE_ARGS="$PROFILE_ARGS -P$(echo "$p" | tr -d ' ')"; \
      done; \
      mvn -B -DskipTests $PROFILE_ARGS '-P!providers-all' package; \
    fi

FROM eclipse-temurin:21-jre-alpine
RUN apk add --no-cache curl
WORKDIR /app
COPY --from=build /app/backend/eventore-server/target/eventore-server-*.jar app.jar
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8080/actuator/health/readiness || exit 1
ENTRYPOINT ["java", "-jar", "app.jar"]
