# Build from repository root: docker build -f docker/Dockerfile.mcp .
FROM node:20-alpine AS build
WORKDIR /app
COPY mcp/eventore-mcp/package.json mcp/eventore-mcp/package-lock.json ./
RUN npm ci
COPY mcp/eventore-mcp/ ./
RUN npm run build && npm prune --omit=dev

FROM node:20-alpine
WORKDIR /app
ENV MCP_TRANSPORT=http
ENV MCP_PORT=3100
ENV EVENTORE_API_URL=http://eventore-backend:8080/api/v1
COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./
EXPOSE 3100
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s \
  CMD wget -qO- http://127.0.0.1:3100/health || exit 1
CMD ["node", "dist/index.js"]
