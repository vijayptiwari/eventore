<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.eventore</groupId>
    <artifactId>eventore-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>eventore-parent</name>
    <description>Eventore multi-module streaming platform</description>

    <modules>
        <module>eventore-core</module>
        <module>eventore-provider-kafka</module>
        <module>eventore-provider-mqtt</module>
        <module>eventore-provider-jms</module>
        <module>eventore-provider-pulsar</module>
        <module>eventore-provider-rabbitmq</module>
        <module>eventore-provider-kinesis</module>
        <module>eventore-provider-gcp-pubsub</module>
        <module>eventore-provider-azure-servicebus</module>
        <module>eventore-api-codegen</module>
        <module>eventore-server</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <eventore.version>0.1.0-SNAPSHOT</eventore.version>
        <pulsar.version>3.3.2</pulsar.version>
        <aws.sdk.version>2.28.21</aws.sdk.version>
        <google.pubsub.version>1.133.1</google.pubsub.version>
        <azure.servicebus.version>7.17.5</azure.servicebus.version>
        <springdoc.version>2.6.0</springdoc.version>
        <openapi.generator.version>7.10.0</openapi.generator.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.eventore</groupId>
                <artifactId>eventore-core</artifactId>
                <version>${eventore.version}</version>
            </dependency>
            <dependency>
                <groupId>com.eventore</groupId>
                <artifactId>eventore-api-codegen</artifactId>
                <version>${eventore.version}</version>
            </dependency>
            <dependency>
                <groupId>com.eventore</groupId>
                <artifactId>eventore-provider-kafka</artifactId>
                <version>${eventore.version}</version>
            </dependency>
            <dependency>
                <groupId>com.eventore</groupId>
                <artifactId>eventore-provider-mqtt</artifactId>
                <version>${eventore.version}</version>
            </dependency>
            <dependency>
                <groupId>com.eventore</groupId>
                <artifactId>eventore-provider-jms</artifactId>
                <version>${eventore.version}</version>
            </dependency>
            <dependency>
                <groupId>com.eventore</groupId>
                <artifactId>eventore-provider-pulsar</artifactId>
                <version>${eventore.version}</version>
            </dependency>
            <dependency>
                <groupId>com.eventore</groupId>
                <artifactId>eventore-provider-rabbitmq</artifactId>
                <version>${eventore.version}</version>
            </dependency>
            <dependency>
                <groupId>com.eventore</groupId>
                <artifactId>eventore-provider-kinesis</artifactId>
                <version>${eventore.version}</version>
            </dependency>
            <dependency>
                <groupId>com.eventore</groupId>
                <artifactId>eventore-provider-gcp-pubsub</artifactId>
                <version>${eventore.version}</version>
            </dependency>
            <dependency>
                <groupId>com.eventore</groupId>
                <artifactId>eventore-provider-azure-servicebus</artifactId>
                <version>${eventore.version}</version>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
